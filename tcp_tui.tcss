#main-container {
    height: 100%;
    width: 100%;
}

#top-panel {
    height: 3;
    margin-bottom: 1;
    padding: 0 1;
}

#host-input {
    width: 1fr;
    border: solid $primary;
    border-title-color: $accent;
    margin-right: 1;
}

#port-input {
    width: 12;
    border: solid $primary;
    border-title-color: $accent;
    margin-right: 1;
}

#connect-btn, #disconnect-all-btn {
    width: auto;
    margin-left: 1;
}

#connection-count {
    width: auto;
    margin-left: 1;
    text-align: center;
    background: $surface-lighten-1;
    border: solid $primary;
    padding: 0 2;
    height: 100%;
    content-align: center middle;
}

#content-panel {
    height: 1fr;
}

#left-panel {
    width: 40%;
    height: 100%;
}

#client-table {
    height: 1fr;
    border: solid $primary;
    border-title-color: $accent;
}

#right-panel {
    width: 60%;
}

#received-log {
    height: 50%;
    border: solid $primary;
    border-title-color: $accent;
    margin-bottom: 1;
}

#send-panel {
    height: 50%;
}

#send-input {
    height: 3;
    border: solid $primary;
    border-title-color: $accent;
    margin-bottom: 1;
}

#sent-log {
    height: 1fr;
    border: solid $primary;
    border-title-color: $accent;
}
